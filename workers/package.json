{
  "name": "@navbook/workers",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm cf-typegen",
    "dev": "wrangler dev --config ../wrangler.toml",
    "deploy": "wrangler deploy --config ../wrangler.toml",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings --config ../wrangler.toml",
    "db:migrate:local": "wrangler d1 migrations apply navbook --local --config ../wrangler.toml",
    "db:migrate:remote": "wrangler d1 migrations apply navbook --remote --config ../wrangler.toml"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "js-md5": "^0.9.2",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260908.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.110.0"
  }
}
