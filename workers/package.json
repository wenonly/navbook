{
  "name": "onenav-workers",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm cf-typegen",
    "dev": "wrangler dev",
    "deploy": "pnpm --filter web build && wrangler deploy",
    "pretest": "pnpm typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply onenav-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply onenav-db --remote",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "js-md5": "^0.9.2",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260908.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.110.0"
  }
}
